{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "time_format": {
          "default": "%d %b %Y %H:%M:%S",
          "title": "Time Format",
          "type": "string",
          "description": "The time format",
          "ecoscope:advanced": true
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to Earth Ranger"
    },
    "gee_project_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/GoogleEarthEngineConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to Google Earth Engine"
    },
    "subject_group_var": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "",
          "type": "string"
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": ""
    },
    "set_previous_period": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresetPreviousPeriod"
            },
            {
              "$ref": "#/$defs/CustomPreviousPeriod"
            },
            {
              "$ref": "#/$defs/CalendarPreviousPeriod"
            }
          ],
          "title": "Offset",
          "description": "How to compute the start of the comparison period."
        }
      },
      "required": [
        "offset"
      ],
      "type": "object",
      "title": ""
    },
    "custom_trajs_filter": {
      "additionalProperties": false,
      "properties": {
        "min_length_meters": {
          "default": 0.001,
          "title": "Min Length Meters",
          "type": "number",
          "description": "Minimum segment length in meters.",
          "ecoscope:advanced": true
        },
        "max_length_meters": {
          "default": 5000,
          "title": "Max Length Meters",
          "type": "number",
          "description": "Maximum segment length in meters.",
          "ecoscope:advanced": true
        },
        "min_time_secs": {
          "default": 1,
          "title": "Min Time Secs",
          "type": "number",
          "description": "Minimum segment duration in seconds.",
          "ecoscope:advanced": true
        },
        "max_time_secs": {
          "default": 21600,
          "title": "Max Time Secs",
          "type": "number",
          "description": "Maximum segment duration in seconds.",
          "ecoscope:advanced": true
        },
        "min_speed_kmhr": {
          "default": 0.01,
          "title": "Min Speed Kmhr",
          "type": "number",
          "description": "Minimum segment speed in km/h.",
          "ecoscope:advanced": true
        },
        "max_speed_kmhr": {
          "default": 9.0,
          "title": "Max Speed Kmhr",
          "type": "number",
          "description": "Maximum segment speed in km/h.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": ""
    },
    "zoom_to_envelope": {
      "additionalProperties": false,
      "properties": {
        "expansion_factor": {
          "default": 1.5,
          "title": "Expansion Factor",
          "type": "number",
          "description": "Factor to expand the bounding box (e.g., 1.2 = 20% larger)",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    },
    "generate_mean_speed_raster": {
      "additionalProperties": false,
      "properties": {
        "step_length": {
          "anyOf": [
            {
              "exclusiveMaximum": 100000,
              "exclusiveMinimum": 500,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 2000,
          "title": "Step Length",
          "description": "Mean step length, used as the resolution if `resolution` is None.",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "GoogleEarthEngineConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "GoogleEarthEngineConnection",
      "type": "object"
    },
    "CalendarPreviousPeriod": {
      "properties": {
        "since": {
          "description": "Select the start date for the comparison period.",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        }
      },
      "required": [
        "since"
      ],
      "title": "Calendar",
      "type": "object"
    },
    "CustomPreviousPeriod": {
      "properties": {
        "years": {
          "default": 0,
          "title": "Years",
          "type": "integer"
        },
        "months": {
          "default": 0,
          "title": "Months",
          "type": "integer"
        },
        "weeks": {
          "default": 0,
          "title": "Weeks",
          "type": "integer"
        },
        "days": {
          "default": 0,
          "title": "Days",
          "type": "integer"
        },
        "hours": {
          "default": 0,
          "title": "Hours",
          "type": "integer"
        },
        "minutes": {
          "default": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "seconds": {
          "default": 0,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "title": "Custom",
      "type": "object"
    },
    "PresetPreviousPeriod": {
      "properties": {
        "preset": {
          "default": "1 month back",
          "description": "Choose a predefined time offset.",
          "enum": [
            "Same as current period",
            "1 month back",
            "3 months back",
            "6 months back",
            "1 year back"
          ],
          "title": "Preset",
          "type": "string"
        }
      },
      "title": "Preset",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone",
        "time_format"
      ]
    },
    "custom_trajs_filter": {
      "ui:order": [
        "min_length_meters",
        "max_length_meters",
        "min_time_secs",
        "max_time_secs",
        "min_speed_kmhr",
        "max_speed_kmhr"
      ]
    },
    "ui:order": [
      "workflow_details",
      "time_range",
      "er_client_name",
      "gee_project_name",
      "subject_group_var",
      "set_previous_period",
      "custom_trajs_filter",
      "zoom_to_envelope",
      "generate_mean_speed_raster"
    ]
  },
  "additionalProperties": false
}
