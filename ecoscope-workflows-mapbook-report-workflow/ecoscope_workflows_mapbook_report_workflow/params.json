{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to Earth Ranger"
    },
    "gee_project_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/GoogleEarthEngineConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to Google Earth Engine"
    },
    "subject_group_var": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "",
          "type": "string"
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": ""
    },
    "set_previous_period": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresetPreviousPeriod"
            },
            {
              "$ref": "#/$defs/CustomPreviousPeriod"
            },
            {
              "$ref": "#/$defs/CalendarPreviousPeriod"
            }
          ],
          "title": "Offset",
          "description": "How to compute the start of the comparison period."
        }
      },
      "required": [
        "offset"
      ],
      "type": "object",
      "title": ""
    },
    "map_overlay": {
      "additionalProperties": false,
      "properties": {
        "option": {
          "anyOf": [
            {
              "$ref": "#/$defs/ERSpatialFeatureGroupOverlayOption"
            },
            {
              "$ref": "#/$defs/LandDxOverlayOption"
            }
          ],
          "title": "Option",
          "description": "Select the overlay source to display on maps."
        }
      },
      "required": [
        "option"
      ],
      "type": "object",
      "title": ""
    },
    "custom_trajs_filter": {
      "additionalProperties": false,
      "properties": {
        "min_length_meters": {
          "default": 0.001,
          "title": "Min Length Meters",
          "type": "number",
          "description": "Minimum segment length in meters.",
          "ecoscope:advanced": true
        },
        "max_length_meters": {
          "default": 5000,
          "title": "Max Length Meters",
          "type": "number",
          "description": "Maximum segment length in meters.",
          "ecoscope:advanced": true
        },
        "min_time_secs": {
          "default": 1,
          "title": "Min Time Secs",
          "type": "number",
          "description": "Minimum segment duration in seconds.",
          "ecoscope:advanced": true
        },
        "max_time_secs": {
          "default": 21600,
          "title": "Max Time Secs",
          "type": "number",
          "description": "Maximum segment duration in seconds.",
          "ecoscope:advanced": true
        },
        "min_speed_kmhr": {
          "default": 0.01,
          "title": "Min Speed Kmhr",
          "type": "number",
          "description": "Minimum segment speed in km/h.",
          "ecoscope:advanced": true
        },
        "max_speed_kmhr": {
          "default": 9.0,
          "title": "Max Speed Kmhr",
          "type": "number",
          "description": "Maximum segment speed in km/h.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": ""
    },
    "zoom_to_envelope": {
      "additionalProperties": false,
      "properties": {
        "expansion_factor": {
          "default": 1.5,
          "title": "Expansion Factor",
          "type": "number",
          "description": "Factor to expand the bounding box (e.g., 1.2 = 20% larger)",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    },
    "generate_mean_speed_raster": {
      "additionalProperties": false,
      "properties": {
        "step_length": {
          "anyOf": [
            {
              "exclusiveMaximum": 100000,
              "exclusiveMinimum": 500,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 2000,
          "title": "Step Length",
          "description": "Mean step length, used as the resolution if `resolution` is None.",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "GoogleEarthEngineConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "GoogleEarthEngineConnection",
      "type": "object"
    },
    "CalendarPreviousPeriod": {
      "properties": {
        "since": {
          "description": "Select the start date for the comparison period.",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        }
      },
      "required": [
        "since"
      ],
      "title": "Calendar",
      "type": "object"
    },
    "CustomPreviousPeriod": {
      "properties": {
        "years": {
          "default": 0,
          "title": "Years",
          "type": "integer"
        },
        "months": {
          "default": 0,
          "title": "Months",
          "type": "integer"
        },
        "weeks": {
          "default": 0,
          "title": "Weeks",
          "type": "integer"
        },
        "days": {
          "default": 0,
          "title": "Days",
          "type": "integer"
        },
        "hours": {
          "default": 0,
          "title": "Hours",
          "type": "integer"
        },
        "minutes": {
          "default": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "seconds": {
          "default": 0,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "title": "Custom",
      "type": "object"
    },
    "PresetPreviousPeriod": {
      "properties": {
        "preset": {
          "default": "1 month back",
          "description": "Choose a predefined time offset.",
          "enum": [
            "Same as current period",
            "1 month back",
            "3 months back",
            "6 months back",
            "1 year back"
          ],
          "title": "Preset",
          "type": "string"
        }
      },
      "title": "Preset",
      "type": "object"
    },
    "ERSpatialFeatureGroupOverlayOption": {
      "description": "Overlay one or more EarthRanger spatial feature groups.",
      "properties": {
        "spatial_feature_groups": {
          "description": "EarthRanger spatial feature groups to display on the maps.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Spatial Feature Groups",
          "type": "array"
        },
        "style": {
          "default": [],
          "description": "Optional: override how the features are rendered. Leave empty to keep the colours set in EarthRanger.",
          "items": {
            "$ref": "#/$defs/LayerStyle"
          },
          "maxItems": 1,
          "title": "Style",
          "type": "array"
        }
      },
      "required": [
        "spatial_feature_groups"
      ],
      "title": "EarthRanger Spatial Feature Groups",
      "type": "object"
    },
    "LandDxOverlayOption": {
      "description": "Use the default LandDx protected-areas layer.",
      "properties": {},
      "title": "LandDx (Default Protected Areas)",
      "type": "object"
    },
    "LayerStyle": {
      "properties": {
        "polygon": {
          "default": [],
          "description": "Polygon styling. Add one entry to override ER native colours.",
          "items": {
            "$ref": "#/$defs/PolygonStyle"
          },
          "maxItems": 1,
          "title": "Polygon",
          "type": "array"
        },
        "line": {
          "default": [],
          "description": "Line styling. Add one entry to override ER native colours.",
          "items": {
            "$ref": "#/$defs/LineStyle"
          },
          "maxItems": 1,
          "title": "Line",
          "type": "array"
        },
        "point": {
          "default": [],
          "description": "Point and icon marker styling. Add one entry to override ER native colours.",
          "items": {
            "$ref": "#/$defs/PointStyle"
          },
          "maxItems": 1,
          "title": "Point",
          "type": "array"
        }
      },
      "title": "",
      "type": "object"
    },
    "LineStyle": {
      "properties": {
        "color": {
          "default": [],
          "description": "Line hex colour(s) e.g. ['#E63946']. Cycles across rows.",
          "items": {
            "type": "string"
          },
          "title": "Color",
          "type": "array"
        },
        "opacity": {
          "default": null,
          "description": "Line opacity 0\u20131. Works with or without color: leave color empty to keep native EarthRanger colours and only adjust their opacity. Leave empty to keep the native opacity.",
          "ge": 0.0,
          "le": 1.0,
          "title": "Opacity",
          "type": "number"
        },
        "width": {
          "default": 2.0,
          "description": "Line width in pixels.",
          "title": "Width",
          "type": "number"
        }
      },
      "title": "",
      "type": "object"
    },
    "PointStyle": {
      "properties": {
        "color": {
          "default": [],
          "description": "Fill hex colour(s). For SVG icons this tints the marker. Cycles across rows.",
          "items": {
            "type": "string"
          },
          "title": "Color",
          "type": "array"
        },
        "size": {
          "default": null,
          "description": "Point radius / icon size in pixels. Leave empty to use the size set in EarthRanger.",
          "title": "Size",
          "type": "number"
        }
      },
      "title": "",
      "type": "object"
    },
    "PolygonStyle": {
      "properties": {
        "fill_color": {
          "default": [],
          "description": "Fill hex colour(s) e.g. ['#FFA500']. Cycles across rows.",
          "items": {
            "type": "string"
          },
          "title": "Fill Color",
          "type": "array"
        },
        "stroke_color": {
          "default": null,
          "description": "Border hex colour.",
          "title": "Stroke Color",
          "type": "string"
        },
        "fill_opacity": {
          "default": null,
          "description": "Fill opacity 0\u20131. Works with or without fill_color: leave fill_color empty to keep native EarthRanger colours and only adjust their opacity. Leave empty to keep the native opacity.",
          "ge": 0.0,
          "le": 1.0,
          "title": "Fill Opacity",
          "type": "number"
        },
        "stroke_width": {
          "default": 2.0,
          "description": "Border width in pixels.",
          "title": "Stroke Width",
          "type": "number"
        }
      },
      "title": "",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "custom_trajs_filter": {
      "ui:order": [
        "min_length_meters",
        "max_length_meters",
        "min_time_secs",
        "max_time_secs",
        "min_speed_kmhr",
        "max_speed_kmhr"
      ]
    },
    "ui:order": [
      "workflow_details",
      "time_range",
      "er_client_name",
      "gee_project_name",
      "subject_group_var",
      "set_previous_period",
      "map_overlay",
      "custom_trajs_filter",
      "zoom_to_envelope",
      "generate_mean_speed_raster"
    ]
  },
  "additionalProperties": false
}
